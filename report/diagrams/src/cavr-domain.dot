digraph D {
  rankdir=LR; nodesep=0.3; ranksep=0.6; splines=true;
  node [shape=plain, fontname="Helvetica", fontsize=10];
  edge [fontname="Helvetica", fontsize=9, color="#444444"];
  ProjectPolicy [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>ProjectPolicy</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">project_policy.json</TD></TR><TR><TD ALIGN="LEFT">approved requirements</TD></TR><TR><TD ALIGN="LEFT">denylist, allowed_scopes</TD></TR><TR><TD ALIGN="LEFT">policy_version</TD></TR></TABLE></TD></TR></TABLE>>];
  Lockfile [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>Lockfile</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">dependencies.lock.json</TD></TR><TR><TD ALIGN="LEFT">name, version, sha256</TD></TR></TABLE></TD></TR></TABLE>>];
  CaptureRecord [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>CaptureRecord</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">source: pip_command / requirements_edit</TD></TR><TR><TD ALIGN="LEFT">raw (redacted)</TD></TR><TR><TD ALIGN="LEFT">requirements[ ]</TD></TR></TABLE></TD></TR></TABLE>>];
  Requirement [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>Requirement</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">name, specifier</TD></TR><TR><TD ALIGN="LEFT">extras, hashes, marker</TD></TR></TABLE></TD></TR></TABLE>>];
  GateDecision [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>GateDecision</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">result: PERMITTED / BLOCK / UNRESOLVED</TD></TR><TR><TD ALIGN="LEFT">rule, reason</TD></TR><TR><TD ALIGN="LEFT">decisions[ ] per requirement</TD></TR></TABLE></TD></TR></TABLE>>];
  RequestVerdict [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>RequestVerdict</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">status: VERIFIED / REJECTED /</TD></TR><TR><TD ALIGN="LEFT">  UNRESOLVED / BLOCK</TD></TR><TR><TD ALIGN="LEFT">stage, rule, reason</TD></TR><TR><TD ALIGN="LEFT">fast_gate_ms, cache_hit</TD></TR><TR><TD ALIGN="LEFT">escalation (M2)</TD></TR><TR><TD ALIGN="LEFT">policy_version, analyzer_version</TD></TR></TABLE></TD></TR></TABLE>>];
  PackageVerdict [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>PackageVerdict</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">package, version</TD></TR><TR><TD ALIGN="LEFT">status, stage, rule, reason</TD></TR><TR><TD ALIGN="LEFT">cache_hit, escalated</TD></TR><TR><TD ALIGN="LEFT">cache lookup: HIT / MISS</TD></TR></TABLE></TD></TR></TABLE>>];
  DependencyTree [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>DependencyTree</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">result, rule, reason</TD></TR><TR><TD ALIGN="LEFT">root, edges</TD></TR><TR><TD ALIGN="LEFT">subtree_digest</TD></TR></TABLE></TD></TR></TABLE>>];
  PackageNode [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>PackageNode</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">name, version</TD></TR><TR><TD ALIGN="LEFT">sha256 of downloaded bytes</TD></TR><TR><TD ALIGN="LEFT">filename, size</TD></TR><TR><TD ALIGN="LEFT">import_names, native_files</TD></TR></TABLE></TD></TR></TABLE>>];
  CapabilityContract [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>CapabilityContract</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">result, rule, reason</TD></TR><TR><TD ALIGN="LEFT">allowed[ ], denied[ ]</TD></TR><TR><TD ALIGN="LEFT">imports[ ], call_sites[ ]</TD></TR><TR><TD ALIGN="LEFT">authority, digest</TD></TR></TABLE></TD></TR></TABLE>>];
  CacheKey [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>CacheKey</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">ecosystem, name, version</TD></TR><TR><TD ALIGN="LEFT">artifact_sha256</TD></TR><TR><TD ALIGN="LEFT">subtree_digest, contract_digest</TD></TR><TR><TD ALIGN="LEFT">policy_version, analyzer_version</TD></TR></TABLE></TD></TR></TABLE>>];
  AdvisoryResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>AdvisoryResult</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">name, version</TD></TR><TR><TD ALIGN="LEFT">result, rule</TD></TR><TR><TD ALIGN="LEFT">mode: LIVE / DATED CACHE</TD></TR><TR><TD ALIGN="LEFT">advisory ids</TD></TR></TABLE></TD></TR></TABLE>>];
  ScanResult [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>ScanResult</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">package, version</TD></TR><TR><TD ALIGN="LEFT">result, rule</TD></TR><TR><TD ALIGN="LEFT">sinks[ ]</TD></TR></TABLE></TD></TR></TABLE>>];
  SinkJudgement [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>SinkJudgement</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">result, rule</TD></TR><TR><TD ALIGN="LEFT">sinks[ ]: GUARD_DISABLED, REACHABLE ...</TD></TR><TR><TD ALIGN="LEFT">proofs[ ]</TD></TR></TABLE></TD></TR></TABLE>>];
  VerdictLogRow [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>VerdictLogRow</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">verdict_log table</TD></TR><TR><TD ALIGN="LEFT">status, rule, fast_gate_ms</TD></TR><TR><TD ALIGN="LEFT">cache_lookup</TD></TR></TABLE></TD></TR></TABLE>>];
  EvidenceChain [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4"><TR><TD BGCOLOR="#eeeeee"><B>EvidenceChain</B></TD></TR><TR><TD><TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD ALIGN="LEFT">hash-chained records</TD></TR><TR><TD ALIGN="LEFT">bounded trust certificate</TD></TR><TR><TD ALIGN="LEFT">(dashboard / API path)</TD></TR></TABLE></TD></TR></TABLE>>];
  CaptureRecord -> Requirement [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*"];
  RequestVerdict -> GateDecision [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1"];
  RequestVerdict -> PackageVerdict [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*"];
  PackageVerdict -> DependencyTree [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1"];
  DependencyTree -> PackageNode [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*"];
  PackageVerdict -> CapabilityContract [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..1"];
  PackageVerdict -> AdvisoryResult [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="1..*"];
  PackageVerdict -> ScanResult [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..*"];
  PackageVerdict -> SinkJudgement [dir=both, arrowtail=diamond, arrowhead=none, taillabel="1", headlabel="0..1"];
  GateDecision -> CaptureRecord [style=dashed, arrowhead=vee, label="evaluates"];
  GateDecision -> ProjectPolicy [style=dashed, arrowhead=vee, label="uses"];
  GateDecision -> Lockfile [style=dashed, arrowhead=vee, label="uses"];
  PackageVerdict -> CacheKey [style=dashed, arrowhead=vee, label="looked up by"];
  CacheKey -> CapabilityContract [style=dashed, arrowhead=vee, label="contract_digest"];
  CacheKey -> DependencyTree [style=dashed, arrowhead=vee, label="subtree_digest"];
  RequestVerdict -> VerdictLogRow [arrowhead=vee, label="logged as", headlabel="1"];
  RequestVerdict -> EvidenceChain [arrowhead=vee, label="certified in", headlabel="0..1"];
}