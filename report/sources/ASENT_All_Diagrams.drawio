  <diagram id="p50175261" name="07 SABLE Terraform obligation-verification process">
    <mxGraphModel dx="1600" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1180" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="07  SABLE · Terraform obligation verification" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17324D;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1530" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="The implemented path verifies baseline authority first, identifies one supported logical successor, then checks the same principal/actions/resource-scope obligation against that successor." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1520" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Inputs&lt;br&gt;trusted baseline + candidate Terraform/HCL&lt;br&gt;registered principal, protected asset, required actions" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="480" y="140" width="640" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="Parse and normalize supported HCL&lt;br&gt;resources · local modules · references · outputs · moved blocks&lt;br&gt;retain parse errors and unsupported constructs" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="640" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="Baseline exists, parses,&lt;br&gt;and obligation holds?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fontColor=#203247;fontSize=12;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.7;" vertex="1" parent="1">
          <mxGeometry x="685" y="375" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;UNKNOWN&lt;/b&gt;&lt;br&gt;missing/empty or unverified baseline&lt;br&gt;or incomplete parse" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="385" width="390" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="Rank candidate successors&lt;br&gt;resource type + moves + physical bucket identity&lt;br&gt;Asset/Stage tags + exported-reference signals" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#197A72;fillColor=#DDF3EF;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="480" y="525" width="640" height="92" as="geometry" />
