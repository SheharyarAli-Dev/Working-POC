  <diagram id="p4329857" name="02 Overall ASENT architecture and data flow">
    <mxGraphModel dx="1800" dy="1070" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1070" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="02  Overall ASENT architecture and evidence flow" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17324D;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1730" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Verified repository path: React UI → FastAPI → Service orchestrator → applicable module analyzers → candidate-bound evidence → shared final gate." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="Developer input&lt;br&gt;&lt;b&gt;SRS / approved plan / policy&lt;/b&gt;&lt;br&gt;baseline + candidate workspace" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="45" y="155" width="225" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="React frontend&lt;br&gt;run forms + evidence views" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="320" y="155" width="220" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="FastAPI application&lt;br&gt;shared + module routes" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="590" y="155" width="245" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Service orchestrator&lt;/b&gt;&lt;br&gt;run lifecycle + routing&lt;br&gt;parallel applicable analyzers" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#197A72;fillColor=#DDF3EF;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="885" y="145" width="285" height="128" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="ContextService + WorkspaceManager&lt;br&gt;module inputs, snapshots, baselines" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="1230" y="155" width="280" height="108" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="Agent / replay / watch adapters&lt;br&gt;tool events + workspace changes" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="1530" y="300" width="230" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n16" value="Run applicable analyzers against the frozen candidate" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="310" width="520" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n18" value="&lt;b&gt;CAVR · dependency security&lt;/b&gt;&lt;br&gt;capture + policy gate&lt;br&gt;artifact/hash + dependency tree&lt;br&gt;advisories + behavior/capability checks" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="65" y="405" width="490" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n19" value="&lt;b&gt;SATRA-RV · application-code security&lt;/b&gt;&lt;br&gt;change localization + supported contract&lt;br&gt;trusted tests + counterfactual validation&lt;br&gt;optional validated tests / repair verification" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="655" y="405" width="490" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n20" value="&lt;b&gt;SABLE · Terraform / IAM security&lt;/b&gt;&lt;br&gt;normalize supported HCL&lt;br&gt;verify baseline + successor attribution&lt;br&gt;project IAM/S3 obligation" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#197A72;fillColor=#DDF3EF;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="1245" y="405" width="490" height="135" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="&lt;b&gt;EvidenceBus&lt;/b&gt;&lt;br&gt;module evidence + run events" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="60" y="600" width="1680" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n25" value="&lt;b&gt;SQLite Store&lt;/b&gt;&lt;br&gt;runs · events · evidence chain" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="170" y="755" width="500" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n26" value="&lt;b&gt;Shared final gate&lt;/b&gt;&lt;br&gt;status + integrity + candidate snapshot + input hash" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="930" y="755" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n32" value="&lt;b&gt;Workflow result&lt;/b&gt;&lt;br&gt;ACCEPT · REVIEW · BLOCK" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=16;strokeColor=#29834B;fillColor=#E2F5E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="910" width="560" height="72" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="Optional/external tools depend on module and environment: PyPI + OSV (CAVR), optional Ollama-generated test candidates (SATRA), optional scanners such as Checkov. Docker/Podman is required for supported external-code sandbox execution. No live AWS deployment is implied." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=10;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="1000" width="1560" height="48" as="geometry" />
