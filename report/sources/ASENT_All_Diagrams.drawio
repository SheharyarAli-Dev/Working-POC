          <mxGeometry x="620" y="650" width="560" height="88" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Security counterfactual&lt;br&gt;mutate a protected ownership predicate" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="60" y="800" width="430" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Validate the test oracle&lt;br&gt;secure baseline passes; counterfactual is killed;&lt;br&gt;repeat result is stable" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="535" y="800" width="430" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="Optional generated test candidates&lt;br&gt;preflight + independent validation&lt;br&gt;against baseline and counterfactual" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="1010" y="800" width="430" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="Optional repair / retry&lt;br&gt;orchestrator may retry when CAVR/SATRA&lt;br&gt;has an actionable rejection" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=11;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="1485" y="800" width="260" height="92" as="geometry" />
        </mxCell>
        <mxCell id="n15" value="&lt;b&gt;Combine verified evidence&lt;/b&gt;&lt;br&gt;contract + trusted tests + counterfactual/oracle + ordinary tests + runtime/build outcome" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
