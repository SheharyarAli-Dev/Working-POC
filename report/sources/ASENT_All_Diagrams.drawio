        <mxCell id="n18" value="&lt;b&gt;INCONCLUSIVE&lt;/b&gt;&lt;br&gt;incomplete evidence or execution" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=11;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1060" width="490" height="58" as="geometry" />
        </mxCell>
        <mxCell id="n34" value="LLM-generated tests are candidates, not trusted evidence by default. This diagram shows the current bounded InvoiceHub security subset; it does not imply exhaustive detection of all vulnerability families." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=10;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
