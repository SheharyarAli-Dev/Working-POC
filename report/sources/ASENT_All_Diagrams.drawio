  <diagram id="p63589455" name="08 SABLE domain model — obligation, correspondence and evidence">
    <mxGraphModel dx="1800" dy="1020" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1020" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n3" value="08  SABLE domain model · protected obligation to decision" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17324D;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1730" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Flow: obligation verifies baseline; candidate model yields successor hypotheses; the same obligation is checked on that successor; candidate-bound evidence feeds the shared gate." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;Registered Obligation&lt;/b&gt;&lt;hr&gt;obligation id&lt;br&gt;principal / IAM role&lt;br&gt;protected logical asset&lt;br&gt;required actions + resource scope&lt;hr&gt;authority: trusted baseline + policy" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="35" y="165" width="390" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;Baseline Model&lt;/b&gt;&lt;hr&gt;normalized resources + addresses&lt;br&gt;attributes · module context&lt;br&gt;reference graph · outputs&lt;br&gt;moved records · parse errors&lt;hr&gt;used to verify the initial obligation" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="465" y="165" width="380" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;Candidate Model&lt;/b&gt;&lt;hr&gt;normalized Terraform resources&lt;br&gt;references + module context&lt;br&gt;outputs + moved blocks&lt;br&gt;unsupported cases / parse errors&lt;hr&gt;same bounded parser" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="885" y="165" width="380" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Successor Hypothesis&lt;/b&gt;&lt;hr&gt;candidate address + score&lt;br&gt;move / physical-bucket evidence&lt;br&gt;Asset + Stage tags&lt;br&gt;exported-reference signal&lt;br&gt;conflict / confidence checks" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#197A72;fillColor=#DDF3EF;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1305" y="165" width="450" height="175" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;Authorization Projection&lt;/b&gt;&lt;hr&gt;principal attachment&lt;br&gt;required action coverage&lt;br&gt;protected S3 object scope&lt;br&gt;grants / denies / missing actions&lt;br&gt;widening / misbinding / outside-model" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="230" y="465" width="410" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="&lt;b&gt;SABLE Result&lt;/b&gt;&lt;hr&gt;&lt;b&gt;PRESERVED&lt;/b&gt; · obligation holds&lt;br&gt;&lt;b&gt;REGRESSED&lt;/b&gt; · known violation&lt;br&gt;&lt;b&gt;UNKNOWN&lt;/b&gt; · insufficient support&lt;hr&gt;reason + uncertainty + trace" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="700" y="465" width="410" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="&lt;b&gt;Candidate-bound Evidence&lt;/b&gt;&lt;hr&gt;run id + analyzer = SABLE&lt;br&gt;module status + input hash&lt;br&gt;candidate snapshot&lt;br&gt;integrity_valid + stale flag&lt;br&gt;details / uncertainty" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;align=left;verticalAlign=top;spacing=8;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1170" y="465" width="430" height="190" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;Shared final decision&lt;/b&gt;&lt;br&gt;ACCEPT / REVIEW / BLOCK&lt;br&gt;only from current, correctly bound, integrity-valid evidence" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=14;strokeColor=#29834B;fillColor=#E2F5E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="790" width="660" height="95" as="geometry" />
        </mxCell>
        <mxCell id="n21" value="Correspondence decides which candidate resource may represent the protected logical asset; authorization then verifies the obligation on that successor. These are separate checks." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=11;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="190" y="925" width="1420" height="46" as="geometry" />
        </mxCell>
        <mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=1;jettySize=auto;html=1;fontFamily=Arial;strokeColor=#526579;strokeWidth=1.8;endArrow=block;endFill=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6">
