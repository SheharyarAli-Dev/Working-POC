          <mxGeometry x="35" y="20" width="1730" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Current implementation path: capture → requirement policy gate → exact artifact verification → dependency/advisory/behavior analysis → evidence-based verdict." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
