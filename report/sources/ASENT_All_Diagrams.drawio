        </mxCell>
        <mxCell id="n17" value="&lt;b&gt;REJECT&lt;/b&gt;&lt;br&gt;supported security / functional regression or weak oracle" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=11;strokeColor=#C44545;fillColor=#FCE8E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
