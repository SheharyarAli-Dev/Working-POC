          <mxGeometry x="45" y="665" width="390" height="82" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="Project the registered obligation onto that successor&lt;br&gt;principal attachment + required actions&lt;br&gt;protected S3 object resource scope" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="480" y="805" width="640" height="90" as="geometry" />
