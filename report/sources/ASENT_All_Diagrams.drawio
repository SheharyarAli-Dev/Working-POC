        <mxCell id="n10" value="One supported successor&lt;br&gt;and principal binding?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fontColor=#203247;fontSize=12;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.7;" vertex="1" parent="1">
