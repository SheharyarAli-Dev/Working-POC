        <mxCell id="n3" value="09  Shared evidence and final-gate decision" style="text;html=1;fontFamily=Arial;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#17324D;fontSize=23;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="20" width="1730" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Decision logic reflects backend/orchestrator/final_gate.py: only current, integrity-valid evidence with matching candidate snapshot and module input hash can justify acceptance." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=12;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="72" width="1720" height="46" as="geometry" />
        </mxCell>
        <mxCell id="n5" value="&lt;b&gt;CAVR evidence&lt;/b&gt;&lt;br&gt;VERIFIED / RESTRICTED&lt;br&gt;REJECTED / UNRESOLVED" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#4776A8;fillColor=#E8F1FA;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="45" y="150" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n6" value="&lt;b&gt;SATRA-RV evidence&lt;/b&gt;&lt;br&gt;ACCEPT / REJECT&lt;br&gt;INCONCLUSIVE" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#7560A8;fillColor=#F0EAFB;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="465" y="150" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n7" value="&lt;b&gt;SABLE evidence&lt;/b&gt;&lt;br&gt;PRESERVED / REGRESSED&lt;br&gt;UNKNOWN / NOT_APPLICABLE" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#197A72;fillColor=#DDF3EF;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="885" y="150" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n8" value="&lt;b&gt;Run context&lt;/b&gt;&lt;br&gt;candidate snapshot&lt;br&gt;per-module current input hashes&lt;br&gt;applicable module set" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1305" y="150" width="430" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n9" value="&lt;b&gt;EvidenceBus + Store&lt;/b&gt;&lt;br&gt;select latest non-stale evidence per applicable module" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="325" width="1680" height="78" as="geometry" />
        </mxCell>
        <mxCell id="n10" value="For each applicable module, verify:&lt;br&gt;evidence + status exist · integrity_valid is exactly true&lt;br&gt;candidate snapshot matches · module input_hash matches" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=13;strokeColor=#64748B;fillColor=#F1F5F9;strokeWidth=1.6;" vertex="1" parent="1">
          <mxGeometry x="420" y="465" width="960" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n11" value="Any trustworthy&lt;br&gt;blocking result?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=6;fontColor=#203247;fontSize=13;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.7;" vertex="1" parent="1">
          <mxGeometry x="785" y="620" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n12" value="&lt;b&gt;BLOCK&lt;/b&gt;&lt;br&gt;CAVR REJECTED, SATRA REJECT,&lt;br&gt;SABLE REGRESSED, or blocking flag" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#C44545;fillColor=#FCE8E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="35" y="805" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="n13" value="&lt;b&gt;REVIEW&lt;/b&gt;&lt;br&gt;missing / stale / invalid / mismatched evidence;&lt;br&gt;unknown or inconclusive status; no supported module" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=11;strokeColor=#B7791F;fillColor=#FFF3D6;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="655" y="805" width="490" height="94" as="geometry" />
        </mxCell>
        <mxCell id="n14" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;every applicable module has current,&lt;br&gt;bound and acceptable evidence" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#29834B;fillColor=#E2F5E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1270" y="805" width="480" height="94" as="geometry" />
        </mxCell>
        <mxCell id="n24" value="CAVR RESTRICTED is acceptable only when the restriction is actually enforced. A trustworthy blocking result takes precedence over review-level uncertainty; otherwise unresolved evidence yields REVIEW." style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=8;fontColor=#536579;fontSize=11;strokeColor=#CBD5E1;fillColor=#F8FAFC;dashed=1;strokeWidth=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="940" width="1560" height="54" as="geometry" />
