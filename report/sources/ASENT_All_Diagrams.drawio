        </mxCell>
        <mxCell id="n16" value="&lt;b&gt;ACCEPT&lt;/b&gt;&lt;br&gt;contract holds and oracle discriminates" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;align=center;verticalAlign=middle;spacing=9;fontColor=#203247;fontSize=12;strokeColor=#29834B;fillColor=#E2F5E8;strokeWidth=1.6;fontStyle=1;" vertex="1" parent="1">
