{
  "schema_version": 1,
  "project": {
    "name": "InvoiceHub"
  },
  "modules": {
    "CAVR": {
      "enabled": true,
      "policy": "cavr/policy.json",
      "requirements_files": [
        "requirements.txt"
      ],
      "verify": "all",
      "import_aliases": {
        "invoice-pdf-safe": [
          "vendor.invoice_pdf_safe"
        ],
        "invoice-pdf-lab": [
          "vendor.invoice_pdf_lab"
        ],
        "pypdf": [
          "pypdf"
        ]
      },
      "source_dirs": [
        "app"
      ]
    },
    "SATRA": {
      "enabled": true,
      "contract": "satra/contract.json",
      "trusted_tests": "satra/trusted_tests",
      "source_dirs": [
        "app"
      ],
      "project_security_tests": "tests/test_security.py"
    },
    "SABLE": {
      "enabled": true,
      "terraform_dirs": [
        "infra"
      ],
      "obligations": "sable/obligations.json"
    }
  }
}
