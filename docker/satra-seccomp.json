    },
    {
      "names": [
        "close_range",
        "execve",
        "fstatfs",
        "statx"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "CAVR addition: runc init after the profile is loaded: checks /proc/thread-self is not overmounted (statx, fstatfs), closes inherited fds (close_range) and starts the container process (execve)"
    },
    {
      "names": [
        "kill",
        "wait4"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "Process signaling and child process waiting (wait4, kill)"
    },
    {
      "names": [
        "prctl",
        "set_tid_address",
        "vfork"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "Processes and threads start (threads, os.system, fork); no privilege-changing syscalls allowed"
    },
    {
      "names": [
        "clone"
      ],
      "action": "SCMP_ACT_ALLOW",
      "args": [
        {
          "index": 0,
          "value": 2122448896,
          "valueTwo": 0,
          "op": "SCMP_CMP_MASKED_EQ"
        }
      ],
      "comment": "CAVR addition: clone only without CLONE_UNTRACED and without namespace flags (mask 0x7E820000 = Docker's namespace mask 0x7E020000 + CLONE_UNTRACED 0x00800000): an untraced child would run outside strace, and a new user or network namespace opens kernel attack surface; such a clone fails with EPERM, recorded"
    },
    {
      "names": [
        "clone3"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 38,
      "comment": "CAVR addition: clone3 answers ENOSYS (as in Docker's default profile): its flags are in memory, which seccomp cannot inspect; glibc then falls back to clone, which is filtered above"
    },
    {
      "names": [
        "bind",
        "connect",
        "getpeername",
        "getsockname",
        "sendto",
        "setsockopt",
        "socket"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "CAVR addition: sockets: allowed so that connect / sendto attempts reach the kernel and are recorded; --network none makes them fail (ENETUNREACH)"
    },
    {
      "names": [
        "chmod",
        "epoll_create1",
        "fadvise64",
        "fcntl",
        "fsync",
        "getcwd",
        "getdents64",
        "listxattr",
        "madvise",
        "mkdir",
        "readlink",
        "readlinkat",
        "rename",
        "rmdir",
        "rseq",
        "sendfile",
        "statfs",
        "umask",
        "uname",
        "unlink",
        "unlinkat",
        "utimensat"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "CAVR addition: Python start-up, pip install --target and import (measured with strace -c under Docker's default profile, 2026-11-23)"
    },
    {
      "names": [
        "chdir",
        "fchdir"
      ],
      "action": "SCMP_ACT_ALLOW",
      "comment": "CAVR addition: chdir and fchdir (PR 7): packages that change directory are traced instead of failing with EPERM; the normaliser follows each process's current directory to resolve relative paths"
    },
    {
      "names": [
